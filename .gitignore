# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
/.venv/
__pycache__/
*.pyc
.ruff_cache/

# local databases — caches + rolling history; binary files that churn on every
# request, so they don't belong in git. When migrating machines, copy
# python_api/social_baseline.db once via rsync/scp (everything else rebuilds).
*.db
*.db-wal
*.db-shm
