TWELVE_DATA_API_KEY=replace_with_twelvedata_key
FMP_API_KEY=replace_with_fmp_key
MARKETSTACK_API_KEY=replace_with_marketstack_key

# Router order: first provider attempted, then auto-fallback on failure.
QUOTE_PROVIDER_PRIORITY=twelvedata,fmp,marketstack
HISTORY_PROVIDER_PRIORITY=twelvedata,fmp,marketstack

# Optional fallback via OpenBB/yfinance when provider keys are unavailable.
ENABLE_YFINANCE=0

# Optional: direct OpenBB discovery provider (leave empty for auto/default).
DISCOVERY_PROVIDER=
